<?xml version="1.0" encoding="utf-8"?>
<com.kdgames.imsakiye.NavBarContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_bar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/nav_pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_navbar"
        android:padding="@dimen/nav_padding">

        <!-- boyut/pozisyon kodda atanır; match_parent kullanma: wrap FrameLayout'u ekran boyu büyütür -->
        <View
            android:id="@+id/nav_highlight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_nav_active" />

        <LinearLayout
            android:id="@+id/nav_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_tab_imsakiye"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/nav_icon_imsakiye"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_crescent" />

                <TextView
                    android:id="@+id/nav_label_imsakiye"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:text="@string/tab_imsakiye"
                    android:textFontWeight="700"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tab_vakitler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/nav_icon_vakitler"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />

                <TextView
                    android:id="@+id/nav_label_vakitler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:text="@string/tab_vakitler"
                    android:textFontWeight="700"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tab_ayarlar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/nav_icon_ayarlar"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sliders" />

                <TextView
                    android:id="@+id/nav_label_ayarlar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:text="@string/tab_ayarlar"
                    android:textFontWeight="700"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.kdgames.imsakiye.NavBarContainer>
