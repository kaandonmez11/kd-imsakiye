<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.01"
        android:paddingStart="@dimen/screen_pad_text"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_pad_text"
        android:text="@string/ayarlar_title"
        android:textColor="@color/ink"
        android:textFontWeight="800"
        android:textSize="@dimen/text_screen_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad_card"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_pad_card">

            <!-- KONUM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/group_konum"
                android:textColor="@color/muted_faint"
                android:textFontWeight="700"
                android:textSize="@dimen/text_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_sm"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settings_city_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/city_label"
                        android:textColor="@color/ink"
                        android:textFontWeight="600"
                        android:textSize="@dimen/text_row" />

                    <TextView
                        android:id="@+id/settings_city_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_row" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/settings_use_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:id="@+id/settings_use_location_icon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_target"
                        app:tint="@color/accent"
                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                    <TextView
                        android:id="@+id/settings_use_location_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/use_location"
                        android:textColor="@color/accent"
                        android:textFontWeight="700"
                        android:textSize="14.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BİLDİRİMLER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.16"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/group_bildirimler"
                android:textColor="@color/muted_faint"
                android:textFontWeight="700"
                android:textSize="@dimen/text_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_sm"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_title"
                        android:textColor="@color/ink"
                        android:textFontWeight="600"
                        android:textSize="@dimen/text_row" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/reminder_subtitle"
                        android:textColor="@color/muted_label"
                        android:textSize="@dimen/text_caption" />

                    <LinearLayout
                        android:id="@+id/reminder_stepper_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_title"
                        android:textColor="@color/ink"
                        android:textFontWeight="600"
                        android:textSize="@dimen/text_row" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/countdown_subtitle"
                        android:textColor="@color/muted_label"
                        android:textSize="@dimen/text_caption" />

                    <LinearLayout
                        android:id="@+id/countdown_stepper_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <!-- GÖRÜNÜM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.16"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/group_gorunum"
                android:textColor="@color/muted_faint"
                android:textFontWeight="700"
                android:textSize="@dimen/text_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_sm"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_track"
                    android:padding="4dp">

                    <!-- boyut/pozisyon kodda atanır; seçim değişince kayarak ilerler -->
                    <View
                        android:id="@+id/seg_highlight"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_segment_selected" />

                    <LinearLayout
                        android:id="@+id/seg_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <TextView
                        android:id="@+id/seg_gunduz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/seg_gunduz"
                        android:textColor="@color/muted_label"
                        android:textFontWeight="600"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/seg_gece"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/seg_gece"
                        android:textColor="@color/muted_label"
                        android:textFontWeight="600"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/seg_otomatik"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/seg_otomatik"
                        android:textColor="@color/muted_label"
                        android:textFontWeight="600"
                        android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/settings_version_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:onClick="onVersionClick"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:textColor="@color/muted_faintest"
        android:textSize="@dimen/text_label" />
</LinearLayout>
