<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_today"
    android:elevation="6dp"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="@color/accent_glow_soft"
    android:outlineSpotShadowColor="@color/accent_glow_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/today_date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textFontWeight="700"
            android:textSize="@dimen/text_card_title" />

        <TextView
            android:id="@+id/today_hijri_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/muted_label"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_today"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/badge_today"
            android:textColor="@color/on_accent"
            android:textFontWeight="700"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp" />
</LinearLayout>
